{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src",
    "server",
    "vite.config.ts"
  ]
}
